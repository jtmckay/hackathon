DATABASE_URL="file:./dev.db"
BOT_TOKEN="your-telegram-bot-token"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Multi-channel mode — three separate Telegram groups
MULTI_CHANNEL_ENABLED="true"
OPERATOR_GROUP_ID="your-operator-group-id"   # Blake + ops team — sees all dispatch reasoning
CUSTOMER_GROUP_ID="your-customer-group-id"   # Customer-facing — warm, no internal data
TECH_GROUP_ID="your-tech-group-id"           # Tech team — job updates, sick reports

# Legacy single-channel fallback (only used when MULTI_CHANNEL_ENABLED=false)
GROUP_CHAT_ID=""
CUSTOMER_CHANNEL_ID=""
OPS_CHANNEL_ID=""
